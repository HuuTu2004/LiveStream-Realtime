# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# ─── Virtual environments ────────────────────────────────────────────
venv/
venv_talking/
.venv/
env/
ENV/

# ─── IDE / OS ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── LiveTalking data (gitignore — quá nặng / per-instance) ─────────
# Model weights (10-15GB)
models/*
!models/.gitkeep

# Avatar/voice/gesture user-uploaded
data/avatars/*
!data/avatars/.gitkeep
data/uploads/
data/voices/*
!data/voices/.gitkeep
data/products.json
data/products.json.bak
data/settings.json
data/settings.local.json
data/record.mp4

# Job artifacts
data/jobs/

# ─── Logs / temp ─────────────────────────────────────────────────────
*.log
server.log
temp*.mp4
temp*.aac
.setup_done

# ─── Secrets ─────────────────────────────────────────────────────────
.env
.env.local
*.local.env
config.json

# ─── Common model file extensions (nếu user lỡ đặt ngoài models/) ───
*.pth
*.pt
*.bin
*.onnx
*.gguf
*.ckpt
*.safetensors
